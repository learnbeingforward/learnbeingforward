generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  COLLEGE_ADMIN
  SUPER_ADMIN
  TRAINER
  ADMIN2
}

enum CertificationStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  ISSUED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  PENDING_RATE
}

enum TechCategory {
  LANGUAGES
  FRONTEND
  BACKEND
  DATABASES
  TOOLS_DEVOPS
  DATA_AI
  APTITUDE
  SOFT_SKILLS
  ROBOTICS
}

enum StudentStatus {
  PRE_REGISTERED
  PENDING_APPROVAL
  ACTIVE
}

enum ContractType {
  CSR
  PER_STUDENT_HOURLY
  PER_DAY_FLAT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  usn          String?
  fatherName   String?
  studentStatus StudentStatus @default(ACTIVE)
  collegeId    String?
  college      College? @relation(fields: [collegeId], references: [id])
  trainerId    String?  @unique
  trainer      Trainer? @relation(fields: [trainerId], references: [id])
  photoUrl     String?
  avatarSeed   String?
  cvUrl        String?
  branch       String?
  semester     Int?
  phone        String?
  gender       String?
  createdAt    DateTime @default(now())

  enrollments           Enrollment[]
  enrollmentRequests    EnrollmentRequest[]
  contentAccessRequests ContentAccessRequest[]
}

model Trainer {
  id         String   @id @default(cuid())
  name       String
  email      String?  @unique
  phone      String?
  bio        String?  @db.Text
  cvUrl      String?
  hourlyRate Int      @default(0)
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  createdAt  DateTime @default(now())

  loginUser        User?
  enrollments      Enrollment[]
  batches          Batch[]
  trainingSessions TrainingSession[]
  invoices         TrainerInvoice[]
  sessionContents  SessionContent[]
}

model College {
  id           String   @id @default(cuid())
  name         String   @unique
  contactEmail String?
  createdAt    DateTime @default(now())

  users                User[]
  enrollments          Enrollment[]
  enrollmentRequests   EnrollmentRequest[]
  attendanceExceptions AttendanceException[]
  batches              Batch[]
  contracts            CollegeContract[]
}

model Course {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  shortDescription String? @db.Text
  description      String  @db.Text
  category         String
  techSlugs        String? @db.Text
  isPlaceholder    Boolean @default(false)
  order            Int     @default(0)
  createdAt        DateTime @default(now())

  modules            CourseModule[]
  enrollments        Enrollment[]
  enrollmentRequests EnrollmentRequest[]
  batches            Batch[]
  sessionContents    SessionContent[]
  courseContents     CourseContent[]
  contracts          CollegeContract[]
}

model CourseModule {
  id         String  @id @default(cuid())
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trackTitle String  @default("Course Modules")
  title      String
  level      String?
  topics     String  @db.Text
  techSlugs  String? @db.Text
  delivery   String? @db.Text
  order      Int     @default(0)

  trainingSessions TrainingSession[]
  sessionContents  SessionContent[]
  subModules       CourseSubModule[]
  courseContents   CourseContent[]

  @@index([courseId])
}

model CourseSubModule {
  id             String       @id @default(cuid())
  courseModuleId String
  courseModule   CourseModule @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  title          String
  order          Int          @default(0)

  courseContents CourseContent[]

  @@index([courseModuleId])
}

model CourseContent {
  id                String           @id @default(cuid())
  courseId          String
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseModuleId    String?
  courseModule      CourseModule?    @relation(fields: [courseModuleId], references: [id])
  courseSubModuleId String?
  courseSubModule   CourseSubModule? @relation(fields: [courseSubModuleId], references: [id])
  title             String
  fileUrl           String
  createdAt         DateTime         @default(now())

  links          ContentLink[]
  accessRequests ContentAccessRequest[]

  @@index([courseId])
  @@index([courseModuleId])
}

model ContentLink {
  id              String        @id @default(cuid())
  courseContentId String
  courseContent   CourseContent @relation(fields: [courseContentId], references: [id], onDelete: Cascade)
  label           String
  url             String
  order           Int           @default(0)

  @@index([courseContentId])
}

model ContentAccessRequest {
  id              String        @id @default(cuid())
  studentId       String
  student         User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseContentId String
  courseContent   CourseContent @relation(fields: [courseContentId], references: [id], onDelete: Cascade)
  status          RequestStatus @default(PENDING)
  requestedAt     DateTime      @default(now())
  decidedAt       DateTime?

  @@unique([studentId, courseContentId])
  @@index([status])
}

model Enrollment {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  collegeId   String?
  college     College? @relation(fields: [collegeId], references: [id])
  enrolledAt  DateTime @default(now())

  totalClasses Int     @default(0)
  trainerId    String?
  trainer      Trainer? @relation(fields: [trainerId], references: [id])
  batchId      String?
  batch        Batch?   @relation(fields: [batchId], references: [id])

  attendanceRecords    AttendanceRecord[]
  certification        Certification?
  attendanceExceptions AttendanceException[]

  @@index([studentId])
  @@index([courseId])
  @@index([collegeId])
  @@index([trainerId])
  @@index([batchId])
}

model Batch {
  id        String   @id @default(cuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  name      String
  semester  Int?
  completed Boolean  @default(false)
  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id])
  createdAt DateTime @default(now())

  enrollments      Enrollment[]
  trainingSessions TrainingSession[]

  @@index([collegeId])
  @@index([courseId])
  @@index([trainerId])
}

model TrainingSession {
  id              String        @id @default(cuid())
  batchId         String
  batch           Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainerId       String
  trainer         Trainer       @relation(fields: [trainerId], references: [id])
  courseModuleId  String?
  courseModule    CourseModule? @relation(fields: [courseModuleId], references: [id])
  topic           String?
  sessionDate     DateTime
  slotNumber      Int
  startTime       String
  endTime         String
  attendanceTaken Boolean       @default(false)
  createdAt       DateTime      @default(now())

  invoiceLineItems TrainerInvoiceSession[]

  @@unique([batchId, sessionDate, slotNumber])
  @@index([batchId])
  @@index([trainerId])
  @@index([sessionDate])
}

model SessionContent {
  id             String        @id @default(cuid())
  trainerId      String
  trainer        Trainer       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  courseId       String?
  course         Course?       @relation(fields: [courseId], references: [id])
  courseModuleId String?
  courseModule   CourseModule? @relation(fields: [courseModuleId], references: [id])
  title          String
  description    String?       @db.Text
  fileUrl        String
  fileType       String
  uploadedAt     DateTime      @default(now())

  @@index([trainerId])
}

model TrainerInvoice {
  id           String        @id @default(cuid())
  trainerId    String
  trainer      Trainer       @relation(fields: [trainerId], references: [id])
  sessionCount Int
  hours        Int
  hourlyRate   Int
  totalAmount  Int
  status       RequestStatus @default(PENDING)
  notes        String?       @db.Text
  submittedAt  DateTime      @default(now())
  decidedAt    DateTime?

  pdfUrl              String?
  approvedAmount      Int?
  deductionAmount     Int?
  deductionReason     String?  @db.Text
  paymentTimelineDays Int?
  approvalPdfUrl      String?
  submitted           Boolean  @default(false)

  proposedByAdminId           String?
  proposedApprove             Boolean?
  proposedDeductionAmount     Int?
  proposedDeductionReason     String? @db.Text
  proposedPaymentTimelineDays Int?
  proposedNote                String? @db.Text
  proposedAt                  DateTime?

  lineItems TrainerInvoiceSession[]

  @@index([trainerId])
  @@index([status])
}

model TrainerInvoiceSession {
  id                String          @id @default(cuid())
  invoiceId         String
  invoice           TrainerInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id])

  @@unique([invoiceId, trainingSessionId])
  @@index([trainingSessionId])
}

model EnrollmentRequest {
  id          String        @id @default(cuid())
  studentId   String
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id])
  collegeId   String?
  college     College?      @relation(fields: [collegeId], references: [id])
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  decidedAt   DateTime?

  @@index([studentId])
  @@index([courseId])
  @@index([collegeId])
  @@index([status])
}

model AttendanceRecord {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classDate    DateTime
  present      Boolean

  @@index([enrollmentId])
}

model Certification {
  id               String              @id @default(cuid())
  enrollmentId     String              @unique
  enrollment       Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status           CertificationStatus @default(NOT_ELIGIBLE)
  trainerApproved  Boolean             @default(false)
  overrideApproved Boolean             @default(false)
  issuedAt         DateTime?
}

model AttendanceException {
  id           String        @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  collegeId    String?
  college      College?      @relation(fields: [collegeId], references: [id])
  reason       String        @db.Text
  status       RequestStatus @default(PENDING)
  requestedAt  DateTime      @default(now())
  decidedAt    DateTime?

  @@index([enrollmentId])
  @@index([collegeId])
  @@index([status])
}

model TeamMember {
  id              String   @id @default(cuid())
  name            String
  role            String
  experienceYears Int
  background      String   @db.Text
  specialties     String   @db.Text
  isFreelancer    Boolean  @default(false)
  colleges        String?  @db.Text
  cvUrl           String?
  avatarSeed      String
  photoUrl        String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  message     String   @db.Text
  submittedAt DateTime @default(now())
}

model ContactProfile {
  id         String  @id @default(cuid())
  name       String
  role       String
  email      String
  phone      String
  avatarSeed String
  photoUrl   String?
  order      Int     @default(0)
}

model Technology {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  iconName String
  category TechCategory
  order    Int          @default(0)
}

model HomeFeature {
  id          String @id @default(cuid())
  icon        String
  title       String
  description String @db.Text
  order       Int    @default(0)
}

model FooterLink {
  id    String @id @default(cuid())
  label String
  href  String
  order Int    @default(0)
}

model PasswordResetRequest {
  id          String        @id @default(cuid())
  name        String
  email       String
  collegeName String?
  role        Role          @default(STUDENT)
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  decidedAt   DateTime?

  @@index([status])
}

model SiteSettings {
  id                  String @id @default("singleton")
  companyContactName  String @default("Lohit Kumar")
  companyContactPhone String @default("+91 99729 34418")
  companyContactEmail String @default("info@learnbeingforward.in")

  companyBankAccountName   String?
  companyBankAccountNumber String?
  companyBankIfsc          String?
  companyBankName          String?
  companyGstNumber         String?
}

model CollegeContract {
  id                 String        @id @default(cuid())
  collegeId          String
  college            College       @relation(fields: [collegeId], references: [id])
  courseId           String
  course             Course        @relation(fields: [courseId], references: [id])
  contractType       ContractType
  ratePerStudentHour Int?
  flatRatePerDay     Int?
  minStudents        Int           @default(100)
  totalDays          Int
  startDate          DateTime
  endDate            DateTime
  targetBranch       String?
  targetSemester     Int?
  status             RequestStatus @default(PENDING)
  requestedAt        DateTime      @default(now())
  decidedAt          DateTime?
  requestedByAdminId String?
  rejectReason       String?       @db.Text
  mouNotes           String?       @db.Text
  mouPdfUrl          String?
  mouGeneratedAt     DateTime?

  invoices CollegeInvoice[]

  @@index([collegeId])
  @@index([status])
}

model CollegeInvoice {
  id            String          @id @default(cuid())
  contractId    String
  contract      CollegeContract @relation(fields: [contractId], references: [id])
  totalStudents Int
  totalHours    Int?
  totalDays     Int?
  totalAmount   Int
  status        RequestStatus   @default(PENDING)
  submittedAt   DateTime        @default(now())
  decidedAt     DateTime?
  pdfUrl        String?
  submitted     Boolean         @default(false)
  rejectReason  String?         @db.Text

  @@index([contractId])
  @@index([status])
}
