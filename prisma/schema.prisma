generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  COLLEGE_ADMIN
  SUPER_ADMIN
  TRAINER
  ADMIN2
  EMPLOYEE
  // A Buy-page customer — never has a college, never an Enrollment, and gets
  // an account only once their order is confirmed paid (see confirmOrderPaid).
  BUYER
}

enum CertificationStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  ISSUED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  PENDING_RATE
  // ContentAccessRequest only: the admin forwarded this request (made by a
  // student below the attendance threshold) to their college instead of
  // deciding it directly — the college's own approve/reject is now final.
  PENDING_COLLEGE
}

enum TechCategory {
  LANGUAGES
  FRONTEND
  BACKEND
  DATABASES
  TOOLS_DEVOPS
  DATA_AI
  APTITUDE
  SOFT_SKILLS
  ROBOTICS
}

enum StudentStatus {
  PRE_REGISTERED
  PENDING_APPROVAL
  ACTIVE
}

enum ContractType {
  CSR
  PER_STUDENT_HOURLY
  PER_DAY_FLAT
}

enum BatchTrainingType {
  CSR
  FREE
  PAID
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum CourseDomain {
  TECHNICAL
  APTITUDE
  SOFT_SKILL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  usn          String?
  fatherName   String?
  studentStatus StudentStatus @default(ACTIVE)
  collegeId    String?
  college      College? @relation(fields: [collegeId], references: [id])
  trainerId    String?  @unique
  trainer      Trainer? @relation(fields: [trainerId], references: [id])
  photoUrl     String?
  avatarSeed   String?
  cvUrl        String?
  branch       String?
  semester     Int?
  phone        String?
  gender       String?
  createdAt    DateTime @default(now())

  // Only populated for role EMPLOYEE: the list of EmployeePageKey strings (see
  // src/lib/employee-access.ts) this custom staff account was granted access to.
  employeePageKeys Json?
  // Only populated for role EMPLOYEE: "ADMIN" or "EMPLOYEE" — a display label only,
  // chosen when the account is created. Access is governed entirely by
  // employeePageKeys regardless of this label; it does not grant anything by itself.
  employeeKind     String?

  enrollments           Enrollment[]
  enrollmentRequests    EnrollmentRequest[]
  contentAccessRequests ContentAccessRequest[]
  assessmentAssignments AssessmentAssignment[]
  passwordResetTokens   PasswordResetToken[]
  siteBuilderPageAccess SiteBuilderPageAccess[]
  courseOrders          CourseOrder[]
}

model Trainer {
  id         String   @id @default(cuid())
  name       String
  email      String?  @unique
  phone      String?
  bio        String?  @db.Text
  cvUrl      String?
  hourlyRate Int      @default(0)
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  createdAt  DateTime @default(now())

  loginUser        User?
  enrollments      Enrollment[]
  batches          Batch[]
  trainingSessions TrainingSession[]
  invoices         TrainerInvoice[]
  sessionContents  SessionContent[]
}

model College {
  id           String   @id @default(cuid())
  name         String   @unique
  contactEmail String?
  createdAt    DateTime @default(now())

  users                User[]
  enrollments          Enrollment[]
  enrollmentRequests   EnrollmentRequest[]
  attendanceExceptions AttendanceException[]
  batches              Batch[]
  batchRequests        BatchRequest[]
  contracts            CollegeContract[]
}

model Course {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  shortDescription String? @db.Text
  description      String  @db.Text
  category         String
  domain           CourseDomain @default(TECHNICAL)
  techSlugs        String? @db.Text
  isPlaceholder    Boolean @default(false)
  order            Int     @default(0)
  createdAt        DateTime @default(now())

  modules            CourseModule[]
  enrollments        Enrollment[]
  enrollmentRequests EnrollmentRequest[]
  batches            Batch[]
  batchRequests      BatchRequest[]
  sessionContents    SessionContent[]
  courseContents     CourseContent[]
  contracts          CollegeContract[]
  buyListing         BuyListing?
}

model CourseModule {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trackTitle  String  @default("Course Modules")
  title       String
  level       String?
  topics      String  @db.Text
  techSlugs   String? @db.Text
  delivery    String? @db.Text
  order       Int     @default(0)
  mainPdfTitle String?
  mainPdfUrl   String?

  trainingSessions      TrainingSession[]
  sessionContents       SessionContent[]
  subModules            CourseSubModule[]
  courseContents        CourseContent[]
  pdfAccessRequests     ContentAccessRequest[]
  buyPreviewLock        BuyPreviewLock?

  @@index([courseId])
}

model CourseSubModule {
  id             String       @id @default(cuid())
  courseModuleId String
  courseModule   CourseModule @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  title          String
  order          Int          @default(0)

  courseContents  CourseContent[]
  sessionContents SessionContent[]

  @@index([courseModuleId])
}

model CourseContent {
  id                String           @id @default(cuid())
  courseId          String
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseModuleId    String?
  courseModule      CourseModule?    @relation(fields: [courseModuleId], references: [id])
  courseSubModuleId String?
  courseSubModule   CourseSubModule? @relation(fields: [courseSubModuleId], references: [id])
  title             String
  fileUrl           String
  createdAt         DateTime         @default(now())

  links          ContentLink[]
  accessRequests ContentAccessRequest[]
  buyPreviewLock BuyPreviewLock?

  @@index([courseId])
  @@index([courseModuleId])
}

model ContentLink {
  id              String        @id @default(cuid())
  courseContentId String
  courseContent   CourseContent @relation(fields: [courseContentId], references: [id], onDelete: Cascade)
  label           String
  url             String
  order           Int           @default(0)

  @@index([courseContentId])
}

model ContentAccessRequest {
  id              String         @id @default(cuid())
  studentId       String
  student         User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseContentId String?
  courseContent   CourseContent? @relation(fields: [courseContentId], references: [id], onDelete: Cascade)
  courseModuleId  String?
  courseModule    CourseModule?  @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  status          RequestStatus  @default(PENDING)
  requestedAt     DateTime       @default(now())
  decidedAt       DateTime?
  // Set only for a trainer's bulk "send content to eligible students" request —
  // every row created by one bulk send shares this id, so the admin can approve or
  // reject the whole batch in a single action instead of one row at a time.
  // bulkTrainerId/bulkBatchId are redundant with what's reachable via the student's
  // enrollment, but keeping them directly on the row avoids rebuilding that chain
  // just to show the admin "who sent this, for which batch" on the review screen.
  groupId         String?
  bulkTrainerId   String?
  bulkBatchId     String?

  @@unique([studentId, courseContentId])
  @@unique([studentId, courseModuleId])
  @@index([status])
  @@index([groupId])
}

model Enrollment {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  collegeId   String?
  college     College? @relation(fields: [collegeId], references: [id])
  enrolledAt  DateTime @default(now())

  totalClasses Int     @default(0)
  trainerId    String?
  trainer      Trainer? @relation(fields: [trainerId], references: [id])
  batchId      String?
  batch        Batch?   @relation(fields: [batchId], references: [id])

  attendanceRecords    AttendanceRecord[]
  certification        Certification?
  attendanceExceptions AttendanceException[]

  @@index([studentId])
  @@index([courseId])
  @@index([collegeId])
  @@index([trainerId])
  @@index([batchId])
}

model Batch {
  id        String   @id @default(cuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  name      String
  semester  Int?
  completed Boolean  @default(false)
  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id])
  createdAt DateTime @default(now())

  // Only set when this batch came out of an approved college BatchRequest —
  // carried straight over from the admin's approval decision.
  trainingType      BatchTrainingType?
  rate              Int?
  trainingStartDate DateTime?
  trainingDays      Int?

  enrollments      Enrollment[]
  trainingSessions TrainingSession[]

  @@index([collegeId])
  @@index([courseId])
  @@index([trainerId])
}

/** A college's request to form a new batch — college picks a course and any
 * students at their college (not limited to ones already enrolled in that
 * course; studentIds not yet enrolled get an Enrollment created on approval).
 * The batch doesn't exist and students aren't notified until a company admin
 * approves it, at which point the training type/rate/schedule they set here
 * get carried onto the real Batch via resultBatchId. */
model BatchRequest {
  id                String             @id @default(cuid())
  collegeId         String
  college           College            @relation(fields: [collegeId], references: [id])
  courseId          String
  course            Course             @relation(fields: [courseId], references: [id])
  name              String?
  semester          Int?
  studentIds        Json
  status            RequestStatus      @default(PENDING)
  trainingType      BatchTrainingType?
  rate              Int?
  trainingStartDate DateTime?
  trainingDays      Int?
  rejectReason      String?            @db.Text
  resultBatchId     String?
  requestedAt       DateTime           @default(now())
  decidedAt         DateTime?

  @@index([collegeId])
  @@index([courseId])
  @@index([status])
}

model TrainingSession {
  id              String        @id @default(cuid())
  batchId         String
  batch           Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainerId       String
  trainer         Trainer       @relation(fields: [trainerId], references: [id])
  courseModuleId  String?
  courseModule    CourseModule? @relation(fields: [courseModuleId], references: [id])
  topic           String?
  sessionDate     DateTime
  slotNumber      Int
  startTime       String
  endTime         String
  attendanceTaken Boolean       @default(false)
  createdAt       DateTime      @default(now())

  invoiceLineItems  TrainerInvoiceSession[]
  attendanceRecords AttendanceRecord[]

  @@unique([batchId, sessionDate, slotNumber])
  @@index([batchId])
  @@index([trainerId])
  @@index([sessionDate])
}

model SessionContent {
  id                String            @id @default(cuid())
  trainerId         String
  trainer           Trainer           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  courseId          String?
  course            Course?           @relation(fields: [courseId], references: [id])
  courseModuleId    String?
  courseModule      CourseModule?     @relation(fields: [courseModuleId], references: [id])
  courseSubModuleId String?
  courseSubModule   CourseSubModule?  @relation(fields: [courseSubModuleId], references: [id])
  title             String
  description       String?           @db.Text
  fileUrl           String
  fileType          String
  uploadedAt        DateTime          @default(now())
  // Only visible to students once the admin reviews it here and sends it — and
  // even then, only to students who actually attended a session this trainer
  // taught for this module (computed at read time from attendance, not a stored
  // per-student grant).
  sharedWithStudents Boolean          @default(false)
  sharedAt           DateTime?

  @@index([trainerId])
  @@index([courseId])
  @@index([courseModuleId])
}

model TrainerInvoice {
  id           String        @id @default(cuid())
  trainerId    String
  trainer      Trainer       @relation(fields: [trainerId], references: [id])
  sessionCount Int
  hours        Int
  hourlyRate   Int
  totalAmount  Int
  status       RequestStatus @default(PENDING)
  notes        String?       @db.Text
  submittedAt  DateTime      @default(now())
  decidedAt    DateTime?

  pdfUrl              String?
  approvedAmount      Int?
  deductionAmount     Int?
  deductionReason     String?  @db.Text
  paymentTimelineDays Int?
  approvalPdfUrl      String?
  submitted           Boolean  @default(false)

  proposedByAdminId           String?
  proposedApprove             Boolean?
  proposedDeductionAmount     Int?
  proposedDeductionReason     String? @db.Text
  proposedPaymentTimelineDays Int?
  proposedNote                String? @db.Text
  proposedAt                  DateTime?

  lineItems TrainerInvoiceSession[]

  @@index([trainerId])
  @@index([status])
}

model TrainerInvoiceSession {
  id                String          @id @default(cuid())
  invoiceId         String
  invoice           TrainerInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id])

  @@unique([invoiceId, trainingSessionId])
  @@index([trainingSessionId])
}

model EnrollmentRequest {
  id          String        @id @default(cuid())
  studentId   String
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id])
  collegeId   String?
  college     College?      @relation(fields: [collegeId], references: [id])
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  decidedAt   DateTime?

  @@index([studentId])
  @@index([courseId])
  @@index([collegeId])
  @@index([status])
}

model AttendanceRecord {
  id                String           @id @default(cuid())
  enrollmentId      String
  enrollment        Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classDate         DateTime
  present           Boolean
  trainingSessionId String?
  trainingSession   TrainingSession? @relation(fields: [trainingSessionId], references: [id])

  @@index([enrollmentId])
  @@index([trainingSessionId])
}

model Certification {
  id               String              @id @default(cuid())
  enrollmentId     String              @unique
  enrollment       Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status           CertificationStatus @default(NOT_ELIGIBLE)
  trainerApproved  Boolean             @default(false)
  overrideApproved Boolean             @default(false)
  issuedAt         DateTime?
}

model AttendanceException {
  id           String        @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  collegeId    String?
  college      College?      @relation(fields: [collegeId], references: [id])
  reason       String        @db.Text
  status       RequestStatus @default(PENDING)
  requestedAt  DateTime      @default(now())
  decidedAt    DateTime?

  @@index([enrollmentId])
  @@index([collegeId])
  @@index([status])
}

model TeamMember {
  id              String   @id @default(cuid())
  name            String
  role            String
  experienceYears Int
  background      String   @db.Text
  specialties     String   @db.Text
  isFreelancer    Boolean  @default(false)
  colleges        String?  @db.Text
  cvUrl           String?
  avatarSeed      String
  photoUrl        String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  message     String   @db.Text
  // "I am a" — College / University | Company | Student | Trainer. Optional
  // since older submissions (and the API) predate this field.
  role        String?
  phone       String?
  submittedAt DateTime @default(now())
}

model ContactProfile {
  id         String  @id @default(cuid())
  name       String
  role       String
  email      String
  phone      String
  avatarSeed String
  photoUrl   String?
  order      Int     @default(0)
}

model Technology {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  iconName String
  category TechCategory
  order    Int          @default(0)
}

model HomeFeature {
  id          String @id @default(cuid())
  icon        String
  title       String
  description String @db.Text
  order       Int    @default(0)
}

model FooterLink {
  id    String @id @default(cuid())
  label String
  href  String
  order Int    @default(0)
}

model PasswordResetRequest {
  id          String        @id @default(cuid())
  name        String
  email       String
  collegeName String?
  role        Role          @default(STUDENT)
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  decidedAt   DateTime?

  @@index([status])
}

/** A single-use, time-limited link emailed to someone who said they forgot
 * their password — they set a new one themselves at /auth/reset-password, no
 * admin action needed. The admin is still notified once it's actually used
 * (see /api/auth/reset-password), for visibility, not approval. */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model SiteSettings {
  id                  String @id @default("singleton")
  companyContactName  String @default("Lohit Kumar")
  companyContactPhone String @default("+91 99729 34418")
  companyContactEmail String @default("support@learnbeingforward.in")

  companyBankAccountName   String?
  companyBankAccountNumber String?
  companyBankIfsc          String?
  companyBankName          String?
  companyGstNumber         String?

  // Shared across every Buy listing — one payment-receiving account for all
  // course purchases, changeable any time from Edit Site > Buy.
  buyUpiId      String?
  buyQrImageUrl String?
}

model CollegeContract {
  id                 String        @id @default(cuid())
  collegeId          String
  college            College       @relation(fields: [collegeId], references: [id])
  courseId           String
  course             Course        @relation(fields: [courseId], references: [id])
  contractType       ContractType
  ratePerStudentHour Int?
  flatRatePerDay     Int?
  minStudents        Int           @default(100)
  totalDays          Int
  startDate          DateTime
  endDate            DateTime
  targetBranch       String?
  targetSemester     Int?
  status             RequestStatus @default(PENDING)
  requestedAt        DateTime      @default(now())
  decidedAt          DateTime?
  requestedByAdminId String?
  rejectReason       String?       @db.Text
  mouNotes           String?       @db.Text
  mouPdfUrl          String?
  mouGeneratedAt     DateTime?
  requestGroupId     String?

  invoices CollegeInvoice[]

  @@index([collegeId])
  @@index([status])
}

model CollegeInvoice {
  id            String          @id @default(cuid())
  contractId    String
  contract      CollegeContract @relation(fields: [contractId], references: [id])
  totalStudents Int
  totalHours    Int?
  totalDays     Int?
  totalAmount   Int
  status        RequestStatus   @default(PENDING)
  submittedAt   DateTime        @default(now())
  decidedAt     DateTime?
  pdfUrl        String?
  submitted     Boolean         @default(false)
  rejectReason  String?         @db.Text
  // The college approving an invoice only means they accepted the amount — it does
  // NOT mean the money has actually been paid. paidAt is set separately, by an
  // explicit "Mark as Paid" action on the company side, once payment is confirmed.
  // paidRequestedAt is the college's own claim ("we've paid this") — a notification
  // goes to the company side, and only once THEY confirm (setting paidAt) does the
  // invoice actually show as Paid anywhere.
  paidRequestedAt DateTime?
  paidAt        DateTime?

  @@index([contractId])
  @@index([status])
}

// ---------- Assessments ----------

enum AssessmentType {
  APTITUDE
  TECHNICAL_APTITUDE
  CODING
}

enum AssessmentQuestionType {
  MCQ
  WRITTEN
  CODING
}

enum AssessmentAttemptStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}

model Assessment {
  id                String         @id @default(cuid())
  type              AssessmentType
  title             String
  description       String?        @db.Text
  durationMinutes    Int            @default(30)
  proctoringEnabled  Boolean        @default(false)
  availableFrom      DateTime?
  availableUntil     DateTime?
  published          Boolean        @default(false)
  createdAt          DateTime       @default(now())

  // ---- Creator-wizard fields (Screen 1: Create Assessment) ----
  // Short internal code shown next to the title (e.g. "APT-2026-R1"). Display-only.
  assessmentCode     String?
  passMark           Int?
  // How many tab-switch/full-screen-exit violations are allowed before the
  // attempt auto-submits. Replaces the formerly hardcoded 3-strike limit.
  tabSwitchLimit     Int            @default(3)
  // Optional overrides for student-facing proctoring copy. Null = the app's
  // existing built-in instructions/summary text (unchanged behaviour).
  instructionsTemplate String?      @db.Text
  submissionMessage    String?      @db.Text
  // Block copy/paste inside the exam window. Independent of proctoringEnabled.
  blockCopyPaste        Boolean      @default(false)
  // Shown as checkbox tiles in Proctoring & Rules; not all are enforced yet —
  // screen-share and face-match need capabilities this app doesn't have.
  requireFaceMatch      Boolean      @default(false)
  requireScreenShare    Boolean      @default(false)
  // JSON map of sectionName -> boolean ("shuffle this section's question order
  // per student"). Null/missing = no shuffling, same as before this existed.
  shuffleSections       String?      @db.Text
  // JSON map of sectionName -> "APTITUDE" | "TECHNICAL" | "CODING" — which of the
  // 3 "Add Question" screens a section's "+ CREATE QUESTION" button opens. Set
  // once, when the section is created.
  sectionKinds          String?      @db.Text

  questions   AssessmentQuestion[]
  assignments AssessmentAssignment[]

  @@index([type])
}

model AssessmentQuestion {
  id            String                 @id @default(cuid())
  assessmentId  String
  assessment    Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  order         Int                    @default(0)
  questionType  AssessmentQuestionType
  questionText  String                 @db.Text
  marks         Int                    @default(1)
  // Free-text grouping label an admin can give each question (e.g. "Aptitude",
  // "Technical", "Coding", or any custom name) so one assessment can mix several
  // named sections instead of being locked to its category. Null/blank just means
  // "ungrouped" — an assessment where nobody bothered to name sections behaves
  // exactly as a single flat list, same as before this existed.
  sectionName   String?

  optionA       String?  @db.Text
  optionB       String?  @db.Text
  optionC       String?  @db.Text
  optionD       String?  @db.Text
  correctOption String?
  // MCQ/WRITTEN-only, optional: a read-only code block shown to the student above
  // the options — the "Technical question with a snippet" pattern (predict the
  // output / find the error), without needing a separate question type.
  snippetLanguage String?
  snippetCode     String? @db.Text

  // CODING-only: a JSON map of language -> starter code, e.g. {"python": "...",
  // "java": "...", "c": "...", "cpp": "..."}. Null/missing entries just start blank.
  starterCode   String?  @db.Text
  testCases     CodingTestCase[]
  // CODING-only, optional: overrides the default 8s execution timeout per test
  // case run. Pairing a tight limit (e.g. 1-2s) with a large hidden test case lets
  // an admin fail a brute-force solution that's functionally correct but too slow
  // — the intended algorithm finishes in time, a naive one times out.
  timeLimitSeconds Int?

  // ---- Screen 2/3 fields (Add Aptitude / Add Technical question) ----
  // Aptitude: topic = "Logical reasoning"/"Quantitative"/"Verbal". Technical:
  // topic = subject ("OOP"/"DBMS-SQL"/...), subTopic = "Concept".
  topic            String?
  subTopic         String?
  // Technical only: "predict_output" | "find_error" | "concept_mcq" | "fill_blank".
  questionStyle    String?
  // MCQ only: "SINGLE" | "MULTIPLE" | "NUMERIC".
  answerType       String?  @default("SINGLE")
  // MULTIPLE: comma-separated letters, e.g. "A,C". NUMERIC: correctOption/options unused.
  correctOptions   String?
  numericAnswer    String?
  numericTolerance String?
  difficulty       String?  @default("MEDIUM")
  tags             String?
  negativeMarks    Int?     @default(0)
  // Admin-only solution/explanation, never shown to the student.
  explanation      String?  @db.Text

  // ---- Screen 4 fields (Add Coding question builder) ----
  // Short title shown in the question table and the student's problem header —
  // separate from questionText, which on CODING questions holds the full
  // problem statement (Basics > Question title vs. Problem statement).
  title                     String?
  inputFormat               String? @db.Text
  outputFormat              String? @db.Text
  constraints               String? @db.Text
  sampleInput               String? @db.Text
  sampleOutput              String? @db.Text
  sampleExplanation         String? @db.Text
  // JSON map of language -> "startLine-endLine" (the student-editable range).
  editableRanges            String? @db.Text
  referenceSolutionLanguage String?
  referenceSolution         String? @db.Text
  // Admin-only note on why these test cases were chosen.
  adminNote                 String? @db.Text
  // "PARTIAL" (marks split by test weight) | "ALL_OR_NOTHING".
  scoringMode               String? @default("PARTIAL")
  // "UNLIMITED_LAST" | "UNLIMITED_BEST" | "LIMITED".
  submissionsMode           String? @default("UNLIMITED_LAST")
  submissionsLimit          Int?
  // "DRAFT" | "VALIDATED" — set by the Validate & Run Rules panel.
  status                    String? @default("DRAFT")

  answers       AssessmentAnswer[]

  @@index([assessmentId])
}

/** One input/expected-output pair for a CODING question. The first few (isHidden =
 * false) are shown to the student as worked examples, like LeetCode's visible
 * cases; the rest only run in the background on Submit and never reveal their
 * input or expected output to the student — only the pass/fail count. */
model CodingTestCase {
  id             String             @id @default(cuid())
  questionId     String
  question       AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  input          String             @db.Text
  expectedOutput String             @db.Text
  isHidden       Boolean            @default(false)
  order          Int                @default(0)
  label          String?
  weight         Int?               @default(0)

  @@index([questionId])
}

model AssessmentAssignment {
  id              String                   @id @default(cuid())
  assessmentId    String
  assessment      Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId       String
  student         User                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status              AssessmentAttemptStatus  @default(ASSIGNED)
  violationCount      Int                      @default(0)
  audioViolationCount Int                      @default(0)
  autoSubmitted       Boolean                  @default(false)
  startedAt           DateTime?
  submittedAt         DateTime?
  totalMarks          Int?
  maxMarks            Int?
  needsGrading        Boolean                  @default(false)
  // Only meaningful for assessments that include CODING questions: once set, the
  // student has locked in their MCQ/written answers and moved on to the coding
  // phase, and can't go back. Assessments with no coding questions never touch
  // this — they stay single-phase, same as before.
  mcqPhaseSubmittedAt DateTime?
  // Proctored assessments only: where the student says their webcam physically
  // sits relative to their screen (asked during the pre-exam system check). Used
  // to give the admin context on flagged snapshots — the AI proctor's gaze check
  // is calibrated per-student regardless, so this is informational, not load-bearing.
  cameraPosition      String?
  sentToCollegeAt     DateTime?
  sentToStudentAt     DateTime?
  assignedAt          DateTime                 @default(now())

  answers   AssessmentAnswer[]
  snapshots AssessmentSnapshot[]

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([status])
}

model AssessmentSnapshot {
  id                String               @id @default(cuid())
  assignmentId      String
  assignment        AssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  imageUrl          String
  capturedAt        DateTime             @default(now())
  sharedWithStudent Boolean              @default(false)
  sharedWithCollege Boolean              @default(false)
  // Null for the routine snapshots taken every 30s. Set when the in-browser AI
  // proctor (object + gaze detection, entirely client-side — no video is ever
  // uploaded, just this one frame) flagged the moment it was captured, e.g.
  // "phone_detected", "multiple_people", "looking_away", "no_face".
  flagReason        String?

  @@index([assignmentId])
}

enum NotificationCategory {
  STUDENT
  COLLEGE
  TRAINER
  ADMIN
}

/** Site-wide activity feed for the company side — a student submitting an
 * assessment, a college requesting training or claiming an invoice paid, a trainer
 * submitting an invoice, and so on. Read state is shared across every company-side
 * viewer (super admin, ADMIN2, employees) rather than tracked per-viewer. */
model Notification {
  id          String               @id @default(cuid())
  category    NotificationCategory
  title       String
  message     String?              @db.Text
  href        String?
  read        Boolean              @default(false)
  createdAt   DateTime             @default(now())
  // Beyond the broad category grant, some notifications touch something more
  // sensitive than "any request from a college" — e.g. a college claiming an
  // invoice is paid. When set, a viewer also needs this specific Employee Access
  // key (same ones gating the pages/actions themselves) to see the notification at
  // all, not just to act on it.
  requiredKey String?

  @@index([category])
  @@index([read])
  @@index([createdAt])
}

/** Public-facing "Buy" entry for a course — an overlay of commercial
 * metadata (price, headline, visibility) on top of the real Course record,
 * never a copy of it. Modules/sub-modules/PDFs shown on the public Buy pages
 * always come straight from the live CourseModule/CourseSubModule/
 * CourseContent rows, so editing real course content automatically reflects
 * here with nothing to keep in sync. */
model BuyListing {
  id        String   @id @default(cuid())
  courseId  String   @unique
  course    Course   @relation(fields: [courseId], references: [id])
  price     Int
  headline  String?  @db.Text
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  previewLocks BuyPreviewLock[]
  orders       CourseOrder[]
}

/** Marks one PDF (either a module's whole-course book, or a specific
 * CourseContent item) as preview-locked for a Buy listing — previewFileUrl
 * points at a separately generated, publicly viewable truncated copy
 * (previewPages pages), while the real full file stays behind purchase. */
model BuyPreviewLock {
  id              String         @id @default(cuid())
  buyListingId    String
  buyListing      BuyListing     @relation(fields: [buyListingId], references: [id], onDelete: Cascade)
  courseContentId String?        @unique
  courseContent   CourseContent? @relation(fields: [courseContentId], references: [id], onDelete: Cascade)
  courseModuleId  String?        @unique
  courseModule    CourseModule?  @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  previewPages    Int            @default(4)
  previewFileUrl  String?
  createdAt       DateTime       @default(now())

  @@index([buyListingId])
}

/** One purchase attempt — created the moment a buyer submits their details
 * on the payment page, PENDING until a company admin confirms the manual
 * UPI/QR transfer actually arrived. token gates the buyer's own order-status
 * page and download links (no account/login involved), and is the only
 * credential an email ever carries. */
model CourseOrder {
  id                 String      @id @default(cuid())
  buyListingId       String
  buyListing         BuyListing  @relation(fields: [buyListingId], references: [id])
  buyerName          String
  buyerEmail         String
  buyerPhone         String?
  amount             Int
  token              String      @unique
  status             OrderStatus @default(PENDING)
  buyerClaimedPaidAt DateTime?
  paidAt             DateTime?
  emailSentAt        DateTime?
  createdAt          DateTime    @default(now())

  // Set once payment is confirmed — the BUYER account created so the buyer
  // can log in and view (not download) the course, same as a student.
  buyerUserId String?
  buyerUser   User?   @relation(fields: [buyerUserId], references: [id])

  @@index([buyListingId])
  @@index([status])
  @@index([buyerUserId])
}

model AssessmentAnswer {
  id             String               @id @default(cuid())
  assignmentId   String
  assignment     AssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionId     String
  question       AssessmentQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String?
  writtenAnswer  String?              @db.Text
  isCorrect      Boolean?
  marksAwarded   Int?

  // CODING-only: the student's submitted code, which language it's in, and how
  // many of the question's test cases it passed (out of how many) — the pair
  // powers the proportional marksAwarded and lets the admin review without
  // re-running anything.
  codeSubmission  String? @db.Text
  codeLanguage    String?
  testCasesPassed Int?
  testCasesTotal  Int?
  // How many times Submit Code has actually run (compile errors don't count) —
  // only used when the question's submissionsMode is "LIMITED".
  submissionCount Int     @default(0)

  @@unique([assignmentId, questionId])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Site Builder — a drag-and-drop page builder for the super admin. Portals are
// account types (the 5 built-in ones, plus any custom type an admin defines);
// pages are stored as data (a JSON tree of rows → columns → blocks) and
// rendered generically, never as hand-written code. SiteBuilderPageAccess is
// what actually grants an EMPLOYEE login visibility into a specific built
// page — deliberately separate from EmployeePageKey (which only ever gates
// the app's existing hand-written pages) so this dynamic system can't widen
// access to any of those.
model SiteBuilderPortal {
  id        String   @id @default(cuid())
  name      String
  builtin   Boolean  @default(false)
  basedOn   String?
  scope     String
  icon      String   @default("grid")
  menu      Json     @default("[]")
  createdAt DateTime @default(now())

  pages SiteBuilderPage[]
}

model SiteBuilderPage {
  id        String   @id @default(cuid())
  portalId  String
  portal    SiteBuilderPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  name      String
  subtitle  String?
  icon      String   @default("file")
  status    String   @default("Draft")
  rows      Json     @default("[]")
  records   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  access SiteBuilderPageAccess[]

  @@index([portalId])
}

// Grants one employee User visibility into one SiteBuilderPage.
model SiteBuilderPageAccess {
  id       String          @id @default(cuid())
  pageId   String
  page     SiteBuilderPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  readOnly Boolean         @default(false)

  @@unique([pageId, userId])
  @@index([userId])
}

model SiteBuilderActivity {
  id        String   @id @default(cuid())
  who       String
  what      String
  pageId    String?
  createdAt DateTime @default(now())
}
