generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  COLLEGE_ADMIN
  SUPER_ADMIN
  TRAINER
}

enum CertificationStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  ISSUED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TechCategory {
  LANGUAGES
  FRONTEND
  BACKEND
  DATABASES
  TOOLS_DEVOPS
  DATA_AI
  APTITUDE
  SOFT_SKILLS
  ROBOTICS
}

enum StudentStatus {
  PRE_REGISTERED
  PENDING_APPROVAL
  ACTIVE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  usn          String?
  fatherName   String?
  studentStatus StudentStatus @default(ACTIVE)
  collegeId    String?
  college      College? @relation(fields: [collegeId], references: [id])
  trainerId    String?  @unique
  trainer      Trainer? @relation(fields: [trainerId], references: [id])
  createdAt    DateTime @default(now())

  enrollments        Enrollment[]
  enrollmentRequests EnrollmentRequest[]
}

model Trainer {
  id         String   @id @default(cuid())
  name       String
  email      String?  @unique
  phone      String?
  bio        String?  @db.Text
  cvUrl      String?
  hourlyRate Int      @default(0)
  createdAt  DateTime @default(now())

  loginUser        User?
  enrollments      Enrollment[]
  batches          Batch[]
  trainingSessions TrainingSession[]
  invoices         TrainerInvoice[]
  sessionContents  SessionContent[]
}

model College {
  id           String   @id @default(cuid())
  name         String   @unique
  contactEmail String?
  createdAt    DateTime @default(now())

  users                User[]
  enrollments          Enrollment[]
  enrollmentRequests   EnrollmentRequest[]
  attendanceExceptions AttendanceException[]
  batches              Batch[]
}

model Course {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  shortDescription String? @db.Text
  description      String  @db.Text
  category         String
  techSlugs        String? @db.Text
  isPlaceholder    Boolean @default(false)
  order            Int     @default(0)
  createdAt        DateTime @default(now())

  modules            CourseModule[]
  enrollments        Enrollment[]
  enrollmentRequests EnrollmentRequest[]
  batches            Batch[]
  sessionContents    SessionContent[]
}

model CourseModule {
  id         String  @id @default(cuid())
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trackTitle String  @default("Course Modules")
  title      String
  level      String?
  topics     String  @db.Text
  techSlugs  String? @db.Text
  delivery   String? @db.Text
  order      Int     @default(0)

  trainingSessions TrainingSession[]
  sessionContents  SessionContent[]

  @@index([courseId])
}

model Enrollment {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  collegeId   String?
  college     College? @relation(fields: [collegeId], references: [id])
  enrolledAt  DateTime @default(now())

  totalClasses Int     @default(0)
  trainerId    String?
  trainer      Trainer? @relation(fields: [trainerId], references: [id])
  batchId      String?
  batch        Batch?   @relation(fields: [batchId], references: [id])

  attendanceRecords    AttendanceRecord[]
  certification        Certification?
  attendanceExceptions AttendanceException[]

  @@index([studentId])
  @@index([courseId])
  @@index([collegeId])
  @@index([trainerId])
  @@index([batchId])
}

model Batch {
  id        String   @id @default(cuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  name      String
  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id])
  createdAt DateTime @default(now())

  enrollments      Enrollment[]
  trainingSessions TrainingSession[]

  @@index([collegeId])
  @@index([courseId])
  @@index([trainerId])
}

model TrainingSession {
  id              String        @id @default(cuid())
  batchId         String
  batch           Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainerId       String
  trainer         Trainer       @relation(fields: [trainerId], references: [id])
  courseModuleId  String?
  courseModule    CourseModule? @relation(fields: [courseModuleId], references: [id])
  topic           String?
  sessionDate     DateTime
  slotNumber      Int
  startTime       String
  endTime         String
  attendanceTaken Boolean       @default(false)
  createdAt       DateTime      @default(now())

  invoiceLineItems TrainerInvoiceSession[]

  @@unique([batchId, sessionDate, slotNumber])
  @@index([batchId])
  @@index([trainerId])
  @@index([sessionDate])
}

model SessionContent {
  id             String        @id @default(cuid())
  trainerId      String
  trainer        Trainer       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  courseId       String?
  course         Course?       @relation(fields: [courseId], references: [id])
  courseModuleId String?
  courseModule   CourseModule? @relation(fields: [courseModuleId], references: [id])
  title          String
  description    String?       @db.Text
  fileUrl        String
  fileType       String
  uploadedAt     DateTime      @default(now())

  @@index([trainerId])
}

model TrainerInvoice {
  id           String        @id @default(cuid())
  trainerId    String
  trainer      Trainer       @relation(fields: [trainerId], references: [id])
  sessionCount Int
  hours        Int
  hourlyRate   Int
  totalAmount  Int
  status       RequestStatus @default(PENDING)
  notes        String?       @db.Text
  submittedAt  DateTime      @default(now())
  decidedAt    DateTime?

  lineItems TrainerInvoiceSession[]

  @@index([trainerId])
  @@index([status])
}

model TrainerInvoiceSession {
  id                String          @id @default(cuid())
  invoiceId         String
  invoice           TrainerInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id])

  @@unique([invoiceId, trainingSessionId])
  @@index([trainingSessionId])
}

model EnrollmentRequest {
  id          String        @id @default(cuid())
  studentId   String
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id])
  collegeId   String?
  college     College?      @relation(fields: [collegeId], references: [id])
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  decidedAt   DateTime?

  @@index([studentId])
  @@index([courseId])
  @@index([collegeId])
  @@index([status])
}

model AttendanceRecord {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classDate    DateTime
  present      Boolean

  @@index([enrollmentId])
}

model Certification {
  id               String              @id @default(cuid())
  enrollmentId     String              @unique
  enrollment       Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status           CertificationStatus @default(NOT_ELIGIBLE)
  trainerApproved  Boolean             @default(false)
  overrideApproved Boolean             @default(false)
  issuedAt         DateTime?
}

model AttendanceException {
  id           String        @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  collegeId    String?
  college      College?      @relation(fields: [collegeId], references: [id])
  reason       String        @db.Text
  status       RequestStatus @default(PENDING)
  requestedAt  DateTime      @default(now())
  decidedAt    DateTime?

  @@index([enrollmentId])
  @@index([collegeId])
  @@index([status])
}

model TeamMember {
  id              String   @id @default(cuid())
  name            String
  role            String
  experienceYears Int
  background      String   @db.Text
  specialties     String   @db.Text
  isFreelancer    Boolean  @default(false)
  colleges        String?  @db.Text
  cvUrl           String?
  avatarSeed      String
  photoUrl        String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  message     String   @db.Text
  submittedAt DateTime @default(now())
}

model ContactProfile {
  id         String  @id @default(cuid())
  name       String
  role       String
  email      String
  phone      String
  avatarSeed String
  photoUrl   String?
  order      Int     @default(0)
}

model Technology {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  iconName String
  category TechCategory
  order    Int          @default(0)
}

model HomeFeature {
  id          String @id @default(cuid())
  icon        String
  title       String
  description String @db.Text
  order       Int    @default(0)
}

model FooterLink {
  id    String @id @default(cuid())
  label String
  href  String
  order Int    @default(0)
}

model PasswordResetRequest {
  id          String        @id @default(cuid())
  name        String
  email       String
  collegeName String
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  decidedAt   DateTime?

  @@index([status])
}

model SiteSettings {
  id                  String @id @default("singleton")
  companyContactName  String @default("Lohit Kumar")
  companyContactPhone String @default("+91 99729 34418")
  companyContactEmail String @default("info@learnbeingforward.in")
}
