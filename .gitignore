# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database
/prisma/dev.db
/prisma/dev.db-journal

# uploaded files (CVs, photos, trainer-authored content) — runtime user uploads,
# stored on the server's local disk, not checked in. course-content is NOT listed
# here — those PDFs are static seed content from scripts/generate-course-content.ts
# and need to ship with the app so they exist on the production server after a deploy.
# (A parent-folder ignore can't be selectively un-ignored in gitignore, hence per-subfolder.)
/public/uploads/cv/
/public/uploads/content/
/public/uploads/photo/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code session state
.claude/scheduled_tasks.lock
