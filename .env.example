DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional — without this, file uploads still work but are NOT backed up to
# GitHub, so anything uploaded live through the site is lost the next time
# Hostinger redeploys from a fresh git clone. Create a GitHub Personal Access
# Token (Settings -> Developer settings -> Fine-grained tokens, "Contents:
# Read and write" permission on this repo only) and set it here.
GITHUB_TOKEN=""
# These default to learnbeingforward/learnbeingforward on branch "main" if unset.
GITHUB_REPO_OWNER=""
GITHUB_REPO_NAME=""
GITHUB_REPO_BRANCH=""
